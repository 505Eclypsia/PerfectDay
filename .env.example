# PostgreSQL (используется в docker-compose.yml)
POSTGRES_DB=ideal_day
POSTGRES_USER=ideal_day
POSTGRES_PASSWORD=

DATABASE_URL=

# JWT_SECRET_KEY: секретный ключ для подписи JWT-токенов
JWT_SECRET_KEY=

# CORS_ORIGINS: разрешённые адреса
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
